{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["__flipPg"] }],
    "no-await-in-loop": "off"
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "drizzle",
    "public",
    "test-results",
    "playwright-report"
  ],
  "env": { "browser": true, "node": true, "es2024": true }
}
