{
  "name": "flip",
  "version": "0.1.0",
  "private": true,
  "description": "Spanish learning app with FSRS spaced repetition, AI mnemonics, comprehensible input",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "lint:ox": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:import-vocab": "tsx src/db/import-vocab.ts",
    "audio:gen": "tsx src/db/gen-audio.ts",
    "audio:pairs": "tsx src/db/gen-pairs-audio.ts",
    "icons:gen": "tsx scripts/gen-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "msedge-tts": "^2.0.5",
    "next": "16.2.12",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "^5.0.0",
    "zod": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msedge-tts",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.2.12",
    "oxlint": "^1.64.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0",
    "vitest": "^4.1.6"
  }
}
