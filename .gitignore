# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# postgres data
/postgres-data/
/data/

# editor
.vscode/
.idea/
*.swp
*.swo

# mise local override
.mise.local.toml

# drizzle
drizzle/meta/_journal.json.lock

# generated audio (regenerable)
public/audio/

# downloaded data cache
.cache/

# playwright
test-results/
playwright-report/
.playwright/

# claude code session state
.claude/
